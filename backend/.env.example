# Django
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-backend-domain.com

# CORS (comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# News APIs (optional but recommended)
NEWS_API_KEY=your-newsapi-key
GNEWS_API_KEY=your-gnews-key
RSS_API_KEY=your-newsdata-key
TWITTER_BEARER_TOKEN=

# AI providers (optional)
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_2=
ANTHROPIC_API_KEY_3=

# Email / OTP (optional)
EMAIL_VERIFICATION_API_KEY=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# MongoDB (optional — SQLite is used by default)
MONGODB_NAME=ai_newsfeed
MONGODB_HOST=localhost
MONGODB_PORT=27017
